# ─────────────────────────────────────────────────────────────────────
# SUPABASE — PUBLIC (safe to expose in browser bundle)
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ─────────────────────────────────────────────────────────────────────
# SUPABASE — SECRET (server-side only, never prefix with NEXT_PUBLIC_)
# ─────────────────────────────────────────────────────────────────────
SUPABASE_SERVICE_ROLE_KEY=

# ─────────────────────────────────────────────────────────────────────
# SITE — Update once domain is confirmed. No other change needed.
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://brightsmiledentalclinic.org

# ─────────────────────────────────────────────────────────────────────
# EMAIL — Resend (https://resend.com)
# RESEND_FROM_EMAIL MUST be on a domain that is verified in the Resend
# dashboard (Domains → add domain → publish the DKIM/SPF DNS records).
# Sending from an unverified domain fails every send with HTTP 403
# "domain is not verified" — the booking still saves but no email goes out.
# Use an address on the production domain, e.g. appointments@brightsmiledentalclinic.org
# ─────────────────────────────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=appointments@brightsmiledentalclinic.org
RESEND_FROM_NAME=Bright Smile Dental Clinic

# ─────────────────────────────────────────────────────────────────────
# RATE LIMITING — Upstash Redis (https://upstash.com)
# ─────────────────────────────────────────────────────────────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─────────────────────────────────────────────────────────────────────
# SECURITY — Generate with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────────────
CRON_SECRET=
REVALIDATION_SECRET=

# ─────────────────────────────────────────────────────────────────────
# ANALYTICS — Umami (self-hosted or cloud.umami.is) — PUBLIC, not a secret
# Analytics is fully disabled until both vars below are set.
# NEXT_PUBLIC_UMAMI_DASHBOARD_URL is optional — powers the Admin dashboard's
# "Open Analytics" shortcut link only, has no effect on tracking.
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_UMAMI_SCRIPT_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_UMAMI_DASHBOARD_URL=

# ─────────────────────────────────────────────────────────────────────
# MAPS — PUBLIC (restrict this key to production domain in Google Cloud)
# ─────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ─────────────────────────────────────────────────────────────────────
# SUPABASE CLI — Local development only, never used in application code
# ─────────────────────────────────────────────────────────────────────
SUPABASE_DB_PASSWORD=
